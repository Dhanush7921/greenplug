# Copy to .env (local) or set as GitHub Actions repository variables (Settings -> Secrets and variables -> Actions -> Variables).
# Everything prefixed VITE_ ends up in the public JavaScript bundle. Never put secrets here.

# Google Apps Script web app URL that records form submissions in Google Sheets.
# Leave empty to run the forms in clearly labelled demo mode (nothing is sent or stored).
VITE_LEADS_ENDPOINT=

# Store links. Leave empty while the apps are unpublished: the buttons then show a "coming soon" state.
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=

# Optional public contact email shown on the Contact page.
VITE_CONTACT_EMAIL=

# Optional brand name override (the logo wordmark is in src/components/Logo.tsx).
VITE_BRAND_NAME=GREENPLUG

# Base path for GitHub Pages project sites, e.g. /greenplug-website/. The deploy workflow sets this automatically.
BASE_PATH=/
